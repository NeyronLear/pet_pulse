server {
    listen 80;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;

    # Django сам режет фото по PHOTO_MAX_SIZE во views.py (10МБ) и отвечает
    # понятной ошибкой; 12МБ даёт допустимый запас на multipart-обвязку
    client_max_body_size 12m;

    location /static/ {
        alias /var/www/static/;
        # имена файлов без хеша: браузер должен сверяться с сервером (ETag),
        # иначе после деплоя неделю работает старый app.js
        add_header Cache-Control "no-cache";
    }

    location / {
        proxy_pass http://server:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /media/ {
        alias /var/www/media/;
    }
}